# prl_ur5_ros2.rosinstall
- git:
    local-name: prl_ur5_robot_configuration
    uri: https://github.com/inria-paris-robotics-lab/prl_ur5_robot_configuration.git
    version: ros2
- git:
    local-name: robotiq
    uri: https://github.com/inria-paris-robotics-lab/robotiq.git
    version: ros2
- git:
    local-name: onrobot_ros
    uri: https://github.com/inria-paris-robotics-lab/onrobot_ros.git
    version: ros2
- git:
    local-name: wsg50-ros-pkg
    uri: https://github.com/inria-paris-robotics-lab/wsg50-ros-pkg.git
- git:
    local-name: prl_ur5_calibration
    uri: https://github.com/inria-paris-robotics-lab/prl_ur5_calibration.git
- git:
    local-name: allegro_hand_ros_v4
    uri: https://github.com/inria-paris-robotics-lab/allegro_hand_ros_v4.git
- git:
    local-name: ros2_robotiq_gripper
    uri: https://github.com/PickNikRobotics/ros2_robotiq_gripper.git
    version: main
- git:
    local-name: serial
    uri: https://github.com/tylerjw/serial.git
    version: ros2
- git:
    local-name: zed-ros2-description
    uri: https://github.com/stereolabs/zed-ros2-description.git
    version: main
