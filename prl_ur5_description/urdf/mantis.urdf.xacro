<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="mantis" >
  <!-- Arguments-->
  <xacro:arg name="gz_sim" default="false"/>
  <xacro:arg name="real_robot" default="false"/>

  <!-- Setup files -->
  <xacro:arg name="controller_file" default="$(find prl_ur5_control)/config/dual_arm_controller.yaml"/>
  <xacro:property name="setup_file" value="${xacro.load_yaml('$(find prl_ur5_robot_configuration)/config/standard_setup.yaml')}"/>
  <xacro:property name="network_file" value="${xacro.load_yaml('$(find prl_ur5_robot_configuration)/config/network_setup.yaml')}"/>

  <!-- ur5 arm -->
  <xacro:include filename="$(find prl_ur5_description)/urdf/ur5_complete_arm.urdf.xacro"/>
  <!-- fixed camera-->
  <xacro:include filename="$(find prl_ur5_description)/urdf/_fixed_cameras.urdf.xacro"/>

  <!-- Global frame -->
  <link name="prl_ur5_base"/>
  
  <!-- Workcell: what the arms are mounted on (setup file key "workcell", default "mantis") -->
  <xacro:include filename="$(find prl_ur5_description)/urdf/_workcell_mantis.urdf.xacro"/>
  <xacro:include filename="$(find prl_ur5_description)/urdf/_workcell_bimanual_stand.urdf.xacro"/>
  <xacro:property name="workcell" value="${setup_file.get('workcell', 'mantis')}"/>
  <xacro:unless value="${workcell in ['mantis', 'bimanual_stand']}">
    <xacro:unknown_workcell_type/>
  </xacro:unless>

  <!-- UR model used for the physical/visual parameters of both arms (default "ur5") -->
  <xacro:property name="ur_type" value="${setup_file.get('ur_type', 'ur5')}"/>

  <xacro:if value="${workcell == 'mantis'}">
    <xacro:workcell_mantis parent="prl_ur5_base"/>
    <!-- Height of the table top (prl_ur5_base) above the ground (base_link) -->
    <xacro:property name="workcell_height" value="0.8"/>
    <xacro:property name="left_arm_parent" value="prl_ur5_base"/>
    <xacro:property name="right_arm_parent" value="prl_ur5_base"/>
  </xacro:if>

  <xacro:if value="${workcell == 'bimanual_stand'}">
    <xacro:property name="stand" value="${setup_file.get('bimanual_stand') or dict()}"/>
    <xacro:workcell_bimanual_stand parent="prl_ur5_base"
      arm_mount_height="${stand.get('arm_mount_height', 1.5)}"
      plate_position="${stand.get('plate_position', 0.0)}"
      frame_mass="${stand.get('frame_mass', 69.774)}"/>
    <!-- The stand origin is on the ground -->
    <xacro:property name="workcell_height" value="0.0"/>
    <!-- arm_pose of each arm is its offset from the mounting plate -->
    <xacro:property name="left_arm_parent" value="left_mount_plate"/>
    <xacro:property name="right_arm_parent" value="right_mount_plate"/>
  </xacro:if>

  <!-- Cameras fixtures (if any) -->
  <xacro:if value="${setup_file.get('fixed_cameras_file') is not None}">
    <xacro:fixed_cameras parent="prl_ur5_base" fixed_cameras_file="$(find prl_ur5_robot_configuration)/config/${setup_file['fixed_cameras_file']}" turn_on="true"/>
  </xacro:if>

  <!-- ARMS -->
  <!-- Left arm -->
  <xacro:property name="left" value="${setup_file.get('left')}"/>
  <xacro:property name="left_network" value="${network_file.get('left_network')}"/>
  <xacro:arm prefix="left_"
                 parent="${left_arm_parent}"
                 ur_type="${ur_type}"
                 pose="${left['arm_pose']}"
                 sensors="false"
                 gz_sim="$(arg gz_sim)"
                 ft_sensor="${left.get('ft_sensor')}"
                 gripper="${left.get('gripper')}"
                 gripper_pose="${left.get('gripper_pose')}"
                 camera="${left.get('camera')}"
                 camera_pose="${left.get('camera_pose')}"
                 wrist_connector="${left.get('wrist_connector', True)}"
                 tool_communication="${left.get('tool_communication', False)}"
                 tool_device_name="${left.get('tool_device_name', '/tmp/ttyUR_left')}"
                 gripper_com_port="${left.get('gripper_com_port', '/dev/ttyUSB0')}"
                 initial_positions="${left.get('initial_joint_positions')}"
                 joint_limits_parameters_file="$(find prl_ur5_robot_configuration)/config/${left.get('arm_joint_limits')}"
                 kinematics_parameters_file="$(find prl_ur5_robot_configuration)/config/${left.get('arm_kinematics')}"
                 network = "${left_network}"
                 />
  <!-- Right Arm -->
  <xacro:property name="right" value="${setup_file.get('right')}"/>
  <xacro:property name="right_network" value="${network_file.get('right_network')}"/>
  <xacro:arm prefix="right_"
                 parent="${right_arm_parent}"
                 ur_type="${ur_type}"
                 pose="${right['arm_pose']}"
                 sensors="false"
                 gz_sim="$(arg gz_sim)"
                 ft_sensor="${right.get('ft_sensor')}"
                 gripper="${right.get('gripper')}"
                 gripper_pose="${right.get('gripper_pose')}"
                 camera="${right.get('camera')}"
                 camera_pose="${right.get('camera_pose')}"
                 wrist_connector="${right.get('wrist_connector', True)}"
                 tool_communication="${right.get('tool_communication', False)}"
                 tool_device_name="${right.get('tool_device_name', '/tmp/ttyUR_right')}"
                 gripper_com_port="${right.get('gripper_com_port', '/dev/ttyUSB0')}"
                 initial_positions="${right.get('initial_joint_positions')}"
                 joint_limits_parameters_file="$(find prl_ur5_robot_configuration)/config/${right.get('arm_joint_limits')}"
                 kinematics_parameters_file="$(find prl_ur5_robot_configuration)/config/${right.get('arm_kinematics')}"
                 network = "${right_network}"
                 />
  <!-- Gazebosim plugin -->
  <xacro:if value="$(arg gz_sim)">
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controller_file)</parameters>
        </plugin>
    </gazebo>
  </xacro:if>

  <!-- Linking Arms to world -->
  <link name="base_link" />
  <joint name="base_2_ur" type="fixed">
    <parent link="base_link" />
    <child link="prl_ur5_base" />
    <origin xyz="0 0 ${workcell_height}" rpy="0 0 0" />
  </joint> 

  <!-- Gazebo: the stand is bolted to the floor. Set "anchored: false" to let it stand freely on its casters. -->
  <xacro:if value="${workcell == 'bimanual_stand' and stand.get('anchored', True) and '$(arg gz_sim)'.lower() == 'true'}">
    <link name="world"/>
    <joint name="world_to_base_link" type="fixed">
      <parent link="world"/>
      <child link="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>

</robot>
