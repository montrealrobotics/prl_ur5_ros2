<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- Mantis workcell: Vention table with back and left walls.
       Arms are mounted directly on the table top (prl_ur5_base) using each arm's arm_pose. -->
  <xacro:macro name="workcell_mantis" params="parent">

    <!-- Table -->
    <material name="Blue">
      <color rgba="${0/255} ${30/255} ${70/255} 1.0"/>
    </material>

    <link name="table_link">
      <visual>
        <geometry>
          <mesh filename="file://$(find prl_ur5_description)/model/vention_table.stl"/>
        </geometry>
        <material name="Blue"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find prl_ur5_description)/model/vention_table.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="table_fix" type="fixed">
      <parent link="${parent}"/>
      <child link = "table_link"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- back wall -->
    <link name="backwall_link">
      <visual>
        <geometry>
          <box size="3.5 0.1 2" />
        </geometry>
        <material name="grey"><color rgba="0.8 0.8 0.8 0.2"/></material>
      </visual>
      <collision>
        <geometry>
          <box size="3.5 0.1 2" />
        </geometry>
      </collision>
    </link>

    <joint name="backwall_fix" type="fixed">
      <parent link="${parent}"/>
      <child link = "backwall_link"/>
      <origin xyz="0 -1.05 0.25" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- left wall -->
    <link name="leftwall_link">
      <visual>
        <geometry>
          <box size="0.1 1.95 2" />
        </geometry>
        <material name="grey"><color rgba="0.8 0.8 0.8 0.1"/></material>
      </visual>
      <collision>
        <geometry>
          <box size="0.1 1.95 2" />
        </geometry>
      </collision>
    </link>

    <joint name="leftwall_fix" type="fixed">
      <parent link="${parent}"/>
      <child link = "leftwall_link"/>
      <origin xyz="-1.65 0 0.25" rpy="0.0 0.0 0.0"/>
    </joint>

  </xacro:macro>
</robot>
